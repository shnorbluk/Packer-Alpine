require 'yaml'
box_file = "../packer/alpine-3.24.2.box"

home_dir    = File.realpath(ENV['USERPROFILE'] || ENV['HOME'])
temp_dir    = ENV['TEMP'] ? File.realpath(ENV['TEMP']) : "/tmp"

Vagrant.configure("2") do |config|
    config.vm.box = "alpine-local"
    config.ssh.shell = '/bin/ash'
    config.vm.box_url = box_file

    config.vm.synced_folder home_dir, "/mnt/home", create: true
    config.vm.synced_folder temp_dir, "/mnt/tmp", create: true

    (9000..9010).each do |port|
          config.vm.network "forwarded_port", guest: port, host: port, auto_correct: true
    end

    config.ssh.sudo_command = "doas %c"

    # --- Forward all ports in the range 45670-45679 ---
    (45670..45679).each do |port|
      config.vm.network "forwarded_port", guest: port, host: port
    end

#   --- Shared folders ---
    config.vm.synced_folder home_dir, "/mnt/share/home", create: true
    config.vm.synced_folder temp_dir, "/mnt/share/tmp", create: true
    config.vm.synced_folder ".", "/vagrant", disabled: true

    # --- Add custom shared folders ---
    custom_folders_file = File.join(File.dirname(__FILE__), 'synced_folders.yml')
    if File.exist?(custom_folders_file)
      custom_folders = YAML.load_file(custom_folders_file) || []
      custom_folders.each do |folder|
        host_path = File.expand_path(folder['host'])
        is_readonly = folder['readonly'] || false
        config.vm.synced_folder host_path, folder['guest'], create: true, mount_options: [], readonly: is_readonly
      end
    end

	config.vm.provider "virtualbox" do |vb|
	  vb.memory = 3072
    end
    config.trigger.before :up do |trigger|
        rebuild = false
        if !File.exist?(box_file)
            trigger.info = "Packer box not found, building..."
            rebuild = true
        elsif File.mtime(packer_file) > File.mtime(box_file)
            trigger.info = "Packer recipe file modified, rebuilding..."
            rebuild = true
        else
            trigger.info = "Packer box is up to date"
        end
        if rebuild
            trigger.run = {
                inline:     script
            }
        end
    end
end